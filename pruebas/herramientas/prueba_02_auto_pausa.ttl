; AUTO (rampa 3,2 s), PAUSA y RESUME
; Antes de ejecutar: pulse RESET y espere el banner
; Tera Term debe estar conectado a COM8 (115200 8N1). Control > Macro...
logfile = 'C:\Users\Yoka\git\parcial-c-20240705\evidencias\hito5\'
strconcat logfile 'prueba_02_auto_pausa.log'
logopen logfile 0 0 1
mpause 500
sendln 'STREAM ON'
mpause 400
sendln 'STATUS'
mpause 300
sendln 'MODE AUTO'
mpause 60
sendln 'STATUS'
mpause 9000
sendln 'STATUS'
mpause 300
sendln 'PAUSE'
mpause 200
sendln 'STATUS'
mpause 2500
sendln 'STATUS'
mpause 300
sendln 'RESUME'
mpause 100
sendln 'STATUS'
mpause 5000
sendln 'STATUS'
mpause 300
sendln 'MODE MANUAL'
mpause 300
sendln 'STATUS'
mpause 300
sendln 'STREAM OFF'
mpause 300
mpause 1500
logclose
messagebox 'Prueba terminada. El registro quedo guardado.' 'Hito 5'
end
