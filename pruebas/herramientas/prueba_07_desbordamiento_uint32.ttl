; Tiempo cerca de UINT32_MAX (DIAG WRAP) con AUTO y telemetria activos
; Antes de ejecutar: pulse RESET y espere el banner
; Tera Term debe estar conectado a COM8 (115200 8N1). Control > Macro...
logfile = 'C:\Users\Yoka\git\parcial-c-20240705\evidencias\hito5\'
strconcat logfile 'prueba_07_desbordamiento_uint32.log'
logopen logfile 0 0 1
mpause 500
sendln 'STREAM ON'
mpause 500
sendln 'MODE AUTO'
mpause 100
sendln 'STATUS'
mpause 300
sendln 'DIAG WRAP'
mpause 8000
sendln 'STATUS'
mpause 500
sendln 'MODE MANUAL'
mpause 300
sendln 'STATUS'
mpause 300
sendln 'STREAM OFF'
mpause 300
mpause 1500
logclose
messagebox 'Prueba terminada. El registro quedo guardado.' 'Hito 5'
end
